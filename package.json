{
  "name": "ai-character-chat",
  "version": "1.0.0",
  "description": "A real-time character AI application with WebRTC/WebSocket support and LiveKit integration",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --exec node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "keywords": [
    "character-ai",
    "webrtc",
    "livekit",
    "websocket",
    "real-time"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "livekit-client": "^0.5.0",
    "livekit-server-sdk": "^0.7.0",
    "openai": "^4.20.1",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.0.0",
    "vue": "^3.3.0",
    "concurrently": "^8.2.1",
    "nodemon": "^3.0.1",
    "@types/node": "^20.4.2"
  }
}
